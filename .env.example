# ============================================================
# TRIUMPH BOT - Environment Variables (example / template)
# Copy values into the appropriate .env files. NEVER commit secrets.
# ============================================================

# ----- bot/.env (Discord bot + Render) -----
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_primary_guild_id_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional (public-safe): anon/publishable key, used for local RLS checks (anon context)
# SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here

# Command prefix (can be overridden by DB settings later)
BOT_PREFIX=!

# Logging
LOG_LEVEL=INFO

# Flask health endpoint (Render injects PORT automatically)
HOST=0.0.0.0
PORT=8080

# ----- dashboard/.env.local (Next.js + Vercel) -----
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# DISCORD_BOT_TOKEN=your_discord_bot_token_here
# DISCORD_GUILD_ID=your_primary_guild_id_here
# NEXT_PUBLIC_APP_URL=http://localhost:3000
