# Supabase (project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Public site URL used for metadata and OAuth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-side Discord verification (Phase 11)
# When set, the dashboard verifies guild membership and admin roles via the Discord API.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
